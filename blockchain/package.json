{
  "name": "cipher-blockchain",
  "version": "1.0.0",
  "description": "Blockchain service for Cipher encrypted chat",
  "scripts": {
    "dev": "node scripts/start-dev.js",
    "ganache": "ganache --port 8545 --chain.chainId 1337 --wallet.deterministic",
    "compile": "hardhat compile",
    "deploy:local": "hardhat run scripts/deploy-local.js --network ganache",
    "console": "hardhat console --network ganache",
    "test": "hardhat test"
  },
  "dependencies": {
    "ethers": "^6.16.0"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^4.0.0",
    "hardhat": "^2.19.4",
    "ganache": "^7.9.2"
  }
}
